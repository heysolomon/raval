{
  "manifest_version": 3,
  "name": "Raval — Measure & Inspect Web Pages",
  "version": "0.4.0",
  "description": "Measure, inspect and annotate any webpage: sizes, gaps, fonts, colours and guides. Free and open source.",
  "author": "Raval Contributors",

  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },

  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    "default_title": "Raval"
  },

  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "commands": {
    "toggle-raval": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Toggle Raval on/off"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["assets/*", "assets/fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
